{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/create-checkout-session.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(avif|webp|png|jpg|jpeg|gif|mp3|mp4|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/404", "destination": "/404.html" }
  ],
  "redirects": [
    { "source": "/shop", "destination": "/merch", "permanent": true },
    { "source": "/varsity", "destination": "/merch", "permanent": true },
    { "source": "/ready", "destination": "/merch", "permanent": true },
    { "source": "/stream", "destination": "/", "permanent": true },
    { "source": "/player", "destination": "/", "permanent": true },
    { "source": "/demo", "destination": "/", "permanent": true },
