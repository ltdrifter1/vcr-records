# Stripe (Vercel environment variables)
# Prefer a restricted key (rk_test_… / rk_live_…) over a full secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# Club Credit ledger (optional Redis — preferred)
# Works with Vercel KV or Upstash Redis REST.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Admin grant endpoint: POST /api/club-credit { action:"grant", email, secret }
# CLUB_CREDIT_ADMIN_SECRET=

# Membership prices (optional Stripe Price IDs)
# STRIPE_PRICE_CLUB_LEVEL=price_…   # $5/yr
# Premium is pay-what-you-want (min $10) — no fixed Price ID required

# Optional: Price IDs from `node scripts/sync-stripe-catalog.js`
# STRIPE_PRICE_FMT_DIGITAL=price_…
# STRIPE_PRICE_FMT_CASSETTE=price_…
# STRIPE_PRICE_FMT_VINYL=price_…
# STRIPE_PRICE_DG_J_ADORE=price_…
# STRIPE_PRICE_DG_SUN_AND_MOON_ECLIPSE=price_…
# STRIPE_PRICE_DG_SOLAR_ECLIPSE_PART_2=price_…
# STRIPE_PRICE_DG_LUNAR_ECLIPSE_PART_3=price_…
# STRIPE_PRICE_DG_THE_MYSTIC_JADE_TOUCH=price_…
# STRIPE_PRICE_DG_BRIDGET_IN_MY_ROOM=price_…
# STRIPE_PRICE_DG_NEED_YOU=price_…
# STRIPE_PRICE_DG_TOGETHER=price_…
# STRIPE_PRICE_DG_INLET_KNIGHT=price_…
# STRIPE_PRICE_SM_CASSETTE_INLET_KNIGHT=price_…
# STRIPE_PRICE_CLUB_JOIN=price_…
